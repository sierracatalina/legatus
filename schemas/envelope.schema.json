{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sierracatalina.com/legatus/v0.1/envelope.schema.json",
  "title": "Legatus v0.1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["legatus", "id", "thread", "type", "parents", "clock", "signer", "payload", "sig"],
  "properties": {
    "legatus": { "const": 0 },
    "id": { "$ref": "#/$defs/id" },
    "thread": { "$ref": "#/$defs/id" },
    "type": {
      "enum": ["delegate", "handoff", "approve", "fail", "retry", "cancel", "resume"]
    },
    "parents": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "now"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "now": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ts": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    },
    "signer": {
      "type": "string",
      "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]{1,220}$",
      "maxLength": 256
    },
    "payload": { "type": "object" },
    "sig": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "delegate" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/delegate" } } }
    },
    {
      "if": { "properties": { "type": { "const": "handoff" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/handoff" } } }
    },
    {
      "if": { "properties": { "type": { "const": "approve" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/approve" } } }
    },
    {
      "if": { "properties": { "type": { "const": "fail" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/fail" } } }
    },
    {
      "if": { "properties": { "type": { "const": "retry" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/retry" } } }
    },
    {
      "if": { "properties": { "type": { "const": "cancel" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/cancel" } } }
    },
    {
      "if": { "properties": { "type": { "const": "resume" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/resume" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "principal": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]{1,220}$" },
    "deadline": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "gateFalse": {
      "properties": { "gate": { "const": false } },
      "required": ["gate"],
      "not": { "required": ["approver"] }
    },
    "gateTrue": {
      "properties": { "gate": { "const": true }, "approver": { "$ref": "#/$defs/principal" } },
      "required": ["gate", "approver"]
    },
    "delegate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignee", "task_ref"],
      "properties": {
        "assignee": { "$ref": "#/$defs/principal" },
        "task_ref": { "$ref": "#/$defs/id" },
        "gate": { "type": "boolean", "default": false },
        "approver": { "$ref": "#/$defs/principal" },
        "deadline_now": { "$ref": "#/$defs/deadline" }
      },
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/gateFalse" }] },
        { "allOf": [{ "$ref": "#/$defs/gateTrue" }] },
        { "not": { "anyOf": [{ "required": ["gate"] }, { "required": ["approver"] }] } }
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "$ref": "#/$defs/principal" },
        "gate": { "type": "boolean", "default": false },
        "approver": { "$ref": "#/$defs/principal" },
        "deadline_now": { "$ref": "#/$defs/deadline" }
      },
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/gateFalse" }] },
        { "allOf": [{ "$ref": "#/$defs/gateTrue" }] },
        { "not": { "anyOf": [{ "required": ["gate"] }, { "required": ["approver"] }] } }
      ]
    },
    "approve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["of"],
      "properties": { "of": { "$ref": "#/$defs/id" } }
    },
    "fail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "of": { "$ref": "#/$defs/id" },
        "code": { "enum": ["FAIL_TIMEOUT", "FAIL_REFUSED", "FAIL_FAULT", "FAIL_OTHER"] },
        "note": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["of"],
      "properties": {
        "of": { "$ref": "#/$defs/id" },
        "assignee": { "$ref": "#/$defs/principal" },
        "gate": { "type": "boolean", "default": false },
        "approver": { "$ref": "#/$defs/principal" },
        "deadline_now": { "$ref": "#/$defs/deadline" }
      },
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/gateFalse" }] },
        { "allOf": [{ "$ref": "#/$defs/gateTrue" }] },
        { "not": { "anyOf": [{ "required": ["gate"] }, { "required": ["approver"] }] } }
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "of": { "$ref": "#/$defs/id" },
        "code": { "enum": ["CANCEL_STOP", "CANCEL_SUPERSEDED", "CANCEL_OTHER"] },
        "note": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$" }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "of": { "$ref": "#/$defs/id" },
        "gate": { "type": "boolean", "default": false },
        "approver": { "$ref": "#/$defs/principal" },
        "deadline_now": { "$ref": "#/$defs/deadline" }
      },
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/gateFalse" }] },
        { "allOf": [{ "$ref": "#/$defs/gateTrue" }] },
        { "not": { "anyOf": [{ "required": ["gate"] }, { "required": ["approver"] }] } }
      ]
    }
  }
}
