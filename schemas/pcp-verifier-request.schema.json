{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sierracatalina.com/pcp/v0.1/pcp-verifier-request.schema.json",
  "title": "Legatus to PCP verifier request",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "signer_id", "purpose", "envelope", "proof"],
  "properties": {
    "profile": { "const": "pcp-legatus-v1" },
    "signer_id": {
      "type": "string",
      "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]{1,220}$",
      "maxLength": 256
    },
    "purpose": {
      "enum": [
        "legatus.delegate",
        "legatus.handoff",
        "legatus.approve",
        "legatus.fail",
        "legatus.retry",
        "legatus.cancel",
        "legatus.resume"
      ]
    },
    "envelope": { "$ref": "#/$defs/envelope" },
    "proof": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legatus", "id", "thread", "type", "parents", "clock", "signer", "payload", "sig"],
      "properties": {
        "legatus": { "const": 0 },
        "id": { "$ref": "#/$defs/id" },
        "thread": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["delegate", "handoff", "approve", "fail", "retry", "cancel", "resume"]
        },
        "parents": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seq", "now"],
          "properties": {
            "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "now": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "ts": { "type": "string", "format": "date-time", "maxLength": 64 }
          }
        },
        "signer": {
          "type": "string",
          "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]{1,220}$",
          "maxLength": 256
        },
        "payload": { "type": "object" },
        "sig": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
