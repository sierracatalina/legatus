{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sierracatalina.com/legatus/v0.1/pcp-finalize-request.schema.json",
  "title": "Legatus PCP authorization finalization request",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "authorization_id", "outcome", "envelope_id", "thread", "journal_position"],
  "properties": {
    "profile": { "const": "pcp-legatus-v1" },
    "authorization_id": { "$ref": "#/$defs/id" },
    "outcome": { "enum": ["commit", "release"] },
    "envelope_id": { "$ref": "#/$defs/id" },
    "thread": { "$ref": "#/$defs/id" },
    "journal_position": {
      "oneOf": [
        { "$ref": "#/$defs/safePositive" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "commit" } }, "required": ["outcome"] },
      "then": { "properties": { "journal_position": { "$ref": "#/$defs/safePositive" } } },
      "else": { "properties": { "journal_position": { "type": "null" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "safePositive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
