{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sierracatalina.com/pcp/v0.1/pcp-context-authorization.schema.json",
  "title": "PCP v0.1 binding to a Context Layer request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "type",
    "id",
    "issuer_id",
    "grant_id",
    "subject_id",
    "requester_principal_id",
    "context_request_id",
    "context_request_digest",
    "recipient_id",
    "purpose_code",
    "requested_actions",
    "audience",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "spec_version": { "const": "pcp/0.1" },
    "type": { "const": "pcp_context_authorization" },
    "id": { "type": "string", "pattern": "^urn:pcp:binding:[A-Za-z0-9._~-]+$" },
    "issuer_id": {
      "type": "string",
      "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]+$"
    },
    "grant_id": { "type": "string", "pattern": "^urn:pcp:grant:[A-Za-z0-9._~-]+$" },
    "subject_id": {
      "type": "string",
      "pattern": "^urn:pcp:(?:principal|agent|device):[A-Za-z0-9._~-]+$"
    },
    "requester_principal_id": {
      "type": "string",
      "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]+$"
    },
    "context_request_id": { "type": "string", "minLength": 3, "maxLength": 512 },
    "context_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "recipient_id": { "type": "string", "minLength": 3, "maxLength": 512 },
    "purpose_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 160
    },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "audience": { "type": "string", "minLength": 3, "maxLength": 512 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^urn:pcp:key:[A-Za-z0-9._~-]+$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
