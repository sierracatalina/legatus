{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sierracatalina.com/pcp/v0.1/pcp-aaa-action-binding.schema.json",
  "title": "PCP v0.1 binding to an AAA-discovered action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "type",
    "id",
    "issuer_id",
    "grant_id",
    "subject_id",
    "origin",
    "discovery_url",
    "discovery_document_digest",
    "instructions_url",
    "instructions_document_digest",
    "action_id",
    "endpoint",
    "method",
    "audience",
    "purpose",
    "scope_action",
    "human_confirmation_required",
    "confirmation_receipt_id",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "spec_version": { "const": "pcp/0.1" },
    "type": { "const": "pcp_aaa_action_binding" },
    "id": { "type": "string", "pattern": "^urn:pcp:binding:[A-Za-z0-9._~-]+$" },
    "issuer_id": {
      "type": "string",
      "pattern": "^urn:pcp:principal:[A-Za-z0-9._~-]+$"
    },
    "grant_id": { "type": "string", "pattern": "^urn:pcp:grant:[A-Za-z0-9._~-]+$" },
    "subject_id": {
      "type": "string",
      "pattern": "^urn:pcp:(?:principal|agent|device):[A-Za-z0-9._~-]+$"
    },
    "origin": { "$ref": "#/$defs/httpsOrigin" },
    "discovery_url": { "$ref": "#/$defs/httpsUrl" },
    "discovery_document_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instructions_url": { "$ref": "#/$defs/httpsUrl" },
    "instructions_document_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,99}$"
    },
    "endpoint": { "$ref": "#/$defs/pathOrHttpsUrl" },
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "audience": { "$ref": "#/$defs/httpsOrigin" },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 160
    },
    "scope_action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,99}$"
    },
    "human_confirmation_required": { "type": "boolean" },
    "confirmation_receipt_id": {
      "oneOf": [
        { "type": "string", "pattern": "^urn:pcp:receipt:[A-Za-z0-9._~-]+$" },
        { "type": "null" }
      ]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^urn:pcp:key:[A-Za-z0-9._~-]+$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  },
  "$defs": {
    "httpsOrigin": {
      "type": "string",
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://(?![^/]*@)[^/?#]+$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 1024,
      "pattern": "^https://(?![^/]*@)[^\\s#]+$"
    },
    "pathOrHttpsUrl": {
      "type": "string",
      "maxLength": 1024,
      "anyOf": [
        { "pattern": "^/(?!/)(?!.*\\.\\.)(?!.*#)[^\\s]*$" },
        { "$ref": "#/$defs/httpsUrl" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "human_confirmation_required": { "const": true } },
        "required": ["human_confirmation_required"]
      },
      "then": {
        "properties": { "confirmation_receipt_id": { "type": "string" } }
      }
    },
    {
      "if": {
        "properties": { "human_confirmation_required": { "const": false } },
        "required": ["human_confirmation_required"]
      },
      "then": {
        "properties": { "confirmation_receipt_id": { "type": "null" } }
      }
    }
  ]
}
